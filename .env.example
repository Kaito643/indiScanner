# ThreatHarvester Configuration

# abuse.ch Auth-Key — REQUIRED for ThreatFox, URLhaus and MalwareBazaar.
# Free key from https://auth.abuse.ch/
ABUSE_CH_AUTH_KEY=your_abuse_ch_auth_key_here

# AlienVault OTX API Key (required to enable the OTX source)
OTX_API_KEY=your_otx_api_key_here

# AbuseIPDB API Key (required to enable IP reputation enrichment)
# Free key from https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# VirusTotal API Key (required to enable the VirusTotal source)
# Free key from https://www.virustotal.com/ (account -> API key); 4 req/min
VT_API_KEY=your_virustotal_api_key_here

# Log level: error | warn | info | debug | trace
RUST_LOG=info
